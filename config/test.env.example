# Test profile. Pytest forces APP_ENV=test.
# Warning-level logs and an in-memory SQLite database.

APP_ENV=test
LOG_LEVEL=WARNING
LOG_FORMAT=console
LOG_DIR=logs

DATABASE_URL=sqlite+aiosqlite:///:memory:

CACHE_TTL_PRICES_SECONDS=300
CACHE_TTL_QUOTES_SECONDS=30
CACHE_TTL_NEWS_SECONDS=300
CACHE_TTL_FILINGS_SECONDS=3600
CACHE_TTL_COMPANY_SECONDS=86400
CACHE_TTL_FINANCIALS_SECONDS=86400

FINNHUB_API_KEY=
TWELVEDATA_API_KEY=
SEC_COMPANY_NAME=Example Services
SEC_CONTACT_EMAIL=research@example.com

# Grok is the LLM. XAI_API_KEY is accepted as an alias of GROK_API_KEY.
GROK_API_KEY=
GROK_API_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.7
GROK_TIMEOUT_SECONDS=60

HTTP_TIMEOUT_SECONDS=15
HTTP_RETRY_ATTEMPTS=3
HTTP_RETRY_MIN_SECONDS=0.5
HTTP_RETRY_MAX_SECONDS=8

# Finnhub free tier: 60 calls per minute.
RATE_LIMIT_FINNHUB_CALLS=60
RATE_LIMIT_FINNHUB_PERIOD_SECONDS=60
# Stay under the SEC fair-access limit of 10 requests per second.
RATE_LIMIT_EDGAR_CALLS=8
RATE_LIMIT_EDGAR_PERIOD_SECONDS=1
RATE_LIMIT_TWELVEDATA_CALLS=8
RATE_LIMIT_TWELVEDATA_PERIOD_SECONDS=60
RATE_LIMIT_YFINANCE_CALLS=2
RATE_LIMIT_YFINANCE_PERIOD_SECONDS=1

CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_SECONDS=30

CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
API_BASE_URL=http://127.0.0.1:8000
